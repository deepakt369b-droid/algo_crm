import { NextRequest, NextResponse } from "next/server";
import { betterFetch } from "@better-fetch/fetch";
import type { Session } from "@/lib/auth";

export async function middleware(request: NextRequest) {
  const { pathname } = request.nextUrl;
  
  // Skip auth checks for public routes and auth routes
  if (
    pathname.startsWith("/api") || 
    pathname.startsWith("/_next") || 
    pathname.match(/\.(.*)$/) ||
    pathname.includes("/sign-in") || 
    pathname.includes("/sign-up") ||
    pathname === "/" ||
    pathname === "/pricing" ||
    pathname === "/privacy" ||
    pathname === "/terms"
  ) {
    return NextResponse.next();
  }

  // Get session
  const { data: session } = await betterFetch<Session>(
    "/api/auth/get-session",
    {
      baseURL: request.nextUrl.origin,
      headers: {
        cookie: request.headers.get("cookie") || "",
      },
    },
  );

  if (!session) {
    return NextResponse.redirect(new URL("/sign-in", request.url));
  }

  // Check superadmin routes
  if (pathname.includes("/superadmin") && !session.user.isSuperAdmin && session.user.role !== "superadmin") {
    // Non-superadmins can't access superadmin routes
    return NextResponse.redirect(new URL("/dashboard", request.url));
  }

  // If a normal user is trying to access CRM routes but has no tenantId (e.g. they somehow bypassed signup completion)
  if (!pathname.includes("/superadmin") && !session.user.isSuperAdmin && !session.user.tenantId) {
    // They need a workspace/tenant
    // We could redirect to an onboarding flow, but for now redirect back
    // return NextResponse.redirect(new URL("/onboarding", request.url));
  }

  return NextResponse.next();
}

export const config = {
  matcher: ['/((?!api|_next/static|_next/image|.*\\.png$).*)'],
};
