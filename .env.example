[TEMPLATE]
# FlowlinePro - Environment Variables (Supabase + Cloudflare Pages)
#
# Copy this file to .env.local and fill in your values.
# For Cloudflare Pages, set these in the Pages dashboard > Settings >
# Environment variables (or in wrangler.toml [vars] section).
#
# --- Supabase (required) ---
# Get these from: https://supabase.com/dashboard > Project Settings > API
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# --- Database (required) ---
# Use your Supabase Postgres connection string:
#   Transaction mode (port 6543) for server-side (auth, API routes)
#   Session mode  (port 5432) for migrations / direct SQL
DATABASE_URL=postgresql://postgres.[ref]:[password]@aws-0-[region].pooler.supabase.com:6543/postgres

# --- Better Auth (required) ---
# Generate a secret: openssl rand -base64 32
BETTER_AUTH_SECRET=generate-with-openssl-rand-base64-32
BETTER_AUTH_URL=https://your-cloudflare-pages-domain.pages.dev

# --- App identity (required) ---
NEXT_PUBLIC_APP_URL=https://your-cloudflare-pages-domain.pages.dev
NEXT_PUBLIC_APP_NAME=FlowlinePro

# --- Google OAuth (optional) ---
# GOOGLE_ID=your-google-client-id
# GOOGLE_SECRET=your-google-client-secret

# --- Email - Resend (optional) ---
# RESEND_API_KEY=your-resend-api-key
# RESEND_FROM_EMAIL=noreply@yourdomain.com
# EMAIL_FROM=noreply@yourdomain.com

# --- Email encryption (optional) ---
# Generate with: openssl rand -hex 32
# EMAIL_ENCRYPTION_KEY=your_64_hex_char_key_here

# --- AI - OpenAI (optional) ---
# OPENAI_API_KEY=your-openai-api-key
