# ================================================================
# Algo CRM — Environment Variables (Supabase-first)
# ================================================================
# Copy this file to .env.local and fill in your values.
# For Cloudflare Pages deployment, set ALL of these in:
#   Cloudflare Dashboard → Pages → algo-crm → Settings → Environment variables
#
# IMPORTANT: NEXT_PUBLIC_* vars are baked in at BUILD TIME.
# They must be set in the Cloudflare dashboard BEFORE deploying.
# ================================================================

# ── Supabase (required) ──────────────────────────────────────────
# Get these from: https://supabase.com/dashboard → Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# ── Database (required) ──────────────────────────────────────────
# Use your Supabase Postgres connection string.
# For Better Auth (pg Pool), use the DIRECT connection (port 5432):
#   postgresql://postgres.[ref]:[password]@db.your-project.supabase.co:5432/postgres
# For serverless/edge, use the POOLED connection (port 6543):
#   postgresql://postgres.[ref]:[password]@aws-0-[region].pooler.supabase.com:6543/postgres
DATABASE_URL=postgresql://postgres.[ref]:[password]@db.your-project.supabase.co:5432/postgres

# ── Better Auth (required until auth migration to Supabase Auth) ─
# Generate a secret: openssl rand -base64 32
BETTER_AUTH_SECRET=generate-with-openssl-rand-base64-32
BETTER_AUTH_URL=https://algo-crm-three.vercel.app

# ── App identity (required) ──────────────────────────────────────
NEXT_PUBLIC_APP_URL=https://algo-crm-three.vercel.app
NEXT_PUBLIC_APP_NAME=Algo CRM

# ── Auth OTP email delivery (required for app-owned numeric OTP emails) ─
# Gmail example:
# EMAIL_HOST=smtp.gmail.com
# EMAIL_PORT=465
# EMAIL_USERNAME=your-gmail-address@gmail.com
# EMAIL_PASSWORD=your-gmail-app-password
# EMAIL_FROM=your-gmail-address@gmail.com
# Also accepted:
# SMTP_USER / SMTP_PASSWORD, SMTP_USERNAME / SMTP_PASSWORD,
# GMAIL_USER / GMAIL_APP_PASSWORD
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=465
EMAIL_USERNAME=your-smtp-username
EMAIL_PASSWORD=your-smtp-app-password
EMAIL_FROM=your-smtp-from-address

# ── Encryption keys (required) ───────────────────────────────────
# Generate with: openssl rand -hex 32
ENCRYPTION_KEY=your_64_hex_char_key_here
EMAIL_ENCRYPTION_KEY=your_64_hex_char_key_here
